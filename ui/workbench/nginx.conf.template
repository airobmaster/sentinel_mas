# Workbench container: static app + /api proxied to the API (server-sent events need buffering off).
# API_UPSTREAM and DNS_RESOLVER are filled in at start (nginx image templates): api:8000 and Docker's DNS
# locally, the Cloud Map name and the VPC resolver on AWS. Resolving per request survives API restarts.
server {
    listen 80;
    root /usr/share/nginx/html;
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $api ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;          # live progress (SSE) must not be held back
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: every other path (e.g. /cases/CASE-0001, /callback) serves index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
