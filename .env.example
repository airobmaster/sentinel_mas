# Copy to .env to run against the Docker stack (docker compose up -d --build).
# Without a .env, Sentinel runs fully in-process on the JSON datasets (no services needed).

SENTINEL_DATA_BACKEND=postgres
SENTINEL_PG_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_TOOL_MODE=mcp
SENTINEL_OPA_URL=http://localhost:8181

# Kafka (local broker). On AWS: SENTINEL_KAFKA_SECURITY=msk_iam and the MSK Serverless bootstrap address.
SENTINEL_KAFKA_BOOTSTRAP=localhost:9092
SENTINEL_KAFKA_SECURITY=plaintext

# Neo4j (e.g. Neo4j Desktop with the Graph Data Science plugin). Keep the password only in .env.
SENTINEL_NEO4J_URI=bolt://localhost:7687
SENTINEL_NEO4J_USER=neo4j
SENTINEL_NEO4J_PASSWORD=

# Guardrails: Presidio analyzer (docker compose service) for PII names; patterns still apply without it.
SENTINEL_PRESIDIO_URL=http://localhost:5002
# SENTINEL_PII_REDACTION=true
# SENTINEL_CASE_TOKEN_BUDGET=400000

# Models (Bedrock)
SENTINEL_AWS_REGION=eu-west-2
# SENTINEL_MODEL_NARRATIVE=deepseek.v3.2

# Dev-only token signing key shared with the MCP servers; change it for any shared environment.
# SENTINEL_MCP_DEV_SECRET=dev-only-signing-key-not-for-production
