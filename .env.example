# Copy to .env to run against the Docker stack (docker compose up -d --build).
# Without a .env, Sentinel runs fully in-process on the JSON datasets (no services needed).

SENTINEL_DATA_BACKEND=postgres
SENTINEL_PG_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_TOOL_MODE=mcp
SENTINEL_OPA_URL=http://localhost:8181

# Models (Bedrock)
SENTINEL_AWS_REGION=eu-west-2
# SENTINEL_MODEL_NARRATIVE=deepseek.v3.2

# Dev-only token signing key shared with the MCP servers; change it for any shared environment.
# SENTINEL_MCP_DEV_SECRET=dev-only-signing-key-not-for-production
