{
  "uid": "sentinel-kpis",
  "title": "Sentinel \u00b7 Case KPIs",
  "description": "Work queue, decisions and evaluation results",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Cases waiting, by level",
      "type": "bargauge",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT CASE assigned_role WHEN 'l1' THEN 'L1 analyst' WHEN 'l2' THEN 'L2 investigator' WHEN 'mlro' THEN 'MLRO' ELSE 'unassigned' END AS level, count(*) AS cases FROM cases.alerts WHERE status IN ('awaiting_review', 'awaiting_approval') GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1
    },
    {
      "title": "Cases by status",
      "type": "piechart",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT status, count(*) AS cases FROM cases.alerts GROUP BY status ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "id": 2
    },
    {
      "title": "Waiting longer than 1 hour",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT count(*) AS cases FROM cases.alerts WHERE status IN ('awaiting_review', 'awaiting_approval') AND updated_at < now() - interval '1 hour'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "title": "QA-flagged cases",
      "type": "stat",
      "description": "Automated QA raised issues: always reviewed by QA (BR-18)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT count(*) AS cases FROM cases.alerts WHERE qa_flagged",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "title": "Decisions per hour (level:action)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (detail) (increase(sentinel_case_events_total{type=\"decision_applied\"}[1h]))",
          "legendFormat": "{{detail}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "title": "Tokens per case (latest evaluation runs)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT created_at AS time, (metrics->>'mean_tokens')::float AS tokens FROM evals.runs ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "title": "Evaluation runs (golden set)",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT created_at AS \"run at\", source, split, (metrics->>'cases')::int AS cases, (metrics->>'escalation_recall')::float AS recall, (metrics->>'false_escalation_rate')::float AS \"false escalations\", (metrics->>'acceptable')::float AS acceptable, (metrics->>'citation_validity')::float AS citations, (metrics->>'injections_caught')::float AS injections, (metrics->>'errors')::int AS errors FROM evals.runs ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 7
    }
  ]
}