{
  "uid": "sentinel-platform",
  "title": "Sentinel \u00b7 Platform",
  "description": "API, workers, agent steps, model and tool calls",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Agent step duration p95 (by step)",
      "type": "timeseries",
      "description": "From the traces: time each graph step takes (KYC, Transactions, Screening, Network, Typology, ...)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, sentinel_node) (rate(sentinel_traces_traces_span_metrics_duration_milliseconds_bucket{sentinel_kind=\"node\"}[15m])))",
          "legendFormat": "{{sentinel_node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "title": "Model calls per minute (by agent)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent) (rate(sentinel_model_calls_total[5m])) * 60",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
